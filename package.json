{
  "name": "casamento",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @casa/core test",
    "infra:up": "docker compose up -d postgres minio evolution mailpit",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @casa/db generate",
    "db:migrate": "pnpm --filter @casa/db migrate",
    "db:deploy": "pnpm --filter @casa/db deploy",
    "db:seed": "pnpm --filter @casa/db seed"
  },
  "engines": { "node": ">=22" }
}
