{
  "name": "@casa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./src/router.ts",
  "exports": { ".": { "types": "./src/router.ts" } },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
